# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-32+-char-random-secret

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Payments ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ─── Email / Notifications ────────────────────────────────────────────────────
RESEND_API_KEY=
SENDGRID_API_KEY=
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=

# ─── Scheduling ───────────────────────────────────────────────────────────────
CRON_SECRET=

# ─── Token Encryption (AES-256-GCM) ──────────────────────────────────────────
# Generate: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
# Must be exactly 64 hex characters (32 bytes). Never expose this value.
ENCRYPTION_KEY=

# ─── Google OAuth (Gmail + YouTube) ──────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# OAuth 2.0 Client ID (Web application)
# Authorized redirect URIs:
#   https://yourdomain.com/api/auth/callback/gmail
#   https://yourdomain.com/api/auth/callback/youtube
#   https://yourdomain.com/api/auth/google/callback
# Enable: Gmail API, YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps
# Authorization callback URL: https://yourdomain.com/api/auth/callback/github
# Scopes: read:user, user:email, repo
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── LinkedIn OAuth ───────────────────────────────────────────────────────────
# Create at: https://www.linkedin.com/developers/apps
# Product: Sign In with LinkedIn using OpenID Connect
# Authorized redirect URL: https://yourdomain.com/api/auth/callback/linkedin
# Scopes: openid, profile, email
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─── Upwork OAuth ─────────────────────────────────────────────────────────────
# Apply at: https://www.upwork.com/services/api/apply
# Callback URL: https://yourdomain.com/api/auth/callback/upwork
# Scope: r_userinfo
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_PROFILE_BASE_URL=https://yourdomain.com/p
APP_TIMEZONE=Asia/Kolkata
